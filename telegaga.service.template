# TeleGaGa Systemd Service Template
# This file is automatically generated and uploaded by deploy.sh
# For manual installation, copy to /etc/systemd/system/telegaga.service

[Unit]
Description=TeleGaGa Telegram Bot
After=network.target
# If bot depends on Docker, uncomment the line below:
# After=docker.service

[Service]
Type=simple
# Change User to match your server username
User=YOUR_SERVER_USERNAME
WorkingDirectory=/opt/telegaga
# Update paths according to your deploy.properties configuration
ExecStart=/usr/bin/java -jar /opt/telegaga/telegaga.jar

# Restart policy
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegaga

# Security options (optional, uncomment if needed)
# NoNewPrivileges=true
# PrivateTmp=true

# Resource limits (optional)
# MemoryLimit=512M
# CPUQuota=50%

[Install]
WantedBy=multi-user.target
