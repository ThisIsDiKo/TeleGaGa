# TeleGaGa Multi-Model Ollama Bot Configuration
# Заполните параметры и сохраните как config.properties

# Telegram Bot Token (обязательно)
telegram.token=YOUR_TELEGRAM_BOT_TOKEN

# Ollama Configuration (опционально, есть значения по умолчанию)
ollama.baseUrl=http://localhost:11434
ollama.embeddingModel=nomic-embed-text
