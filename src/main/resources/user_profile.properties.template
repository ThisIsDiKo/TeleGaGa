# =====================================================================
# USER PROFILE — Персональный профиль пользователя
# =====================================================================
# Заполните этот файл, чтобы агент знал о вас, ваших привычках и целях.
# Пустые поля просто игнорируются.
# =====================================================================

# Ваше имя (как обращаться)
user.name=

# Профессия / деятельность
user.occupation=

# Предпочитаемый язык общения (Russian / English / ...)
user.language=Russian

# Ваш часовой пояс
user.timezone=Europe/Moscow

# Интересы и хобби (через запятую)
user.interests=

# Повседневные привычки (режим, ритуалы, рабочий стиль)
user.habits=

# Стиль общения — что вам нравится (кратко/подробно, формально/неформально, ...)
user.communication_style=

# Текущие проекты над которыми работаете
user.current_projects=

# Ваши цели (на месяц, год, жизнь — что хотите)
user.goals=

# Любой дополнительный контекст, который должен знать агент
user.additional_context=
